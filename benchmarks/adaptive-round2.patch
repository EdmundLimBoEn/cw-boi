+  test('learns heavily weighted marks independently of their short element gaps', () => {
+    const text = 'THIS IS THE FIRST TEST SEE EIGHT'
+    for (const wpm of [12, 20, 30]) {
+      const plan = transmission(text, wpm)
+      for (const tone of plan.tones) tone.end += 0.5 * 1.2 / wpm
+      expect(decodeSamples(synthesize(plan, 650, 8000), 8000, { autoTune: false }).text.trim()).toBe(text)
+    }
+  })
+  test('distinguishes key-up carrier leakage amplified by receiver AGC', () => {
+    const text = 'PARIS CQ TEST K'
+    const clean = synthesize(transmission(text, 18), 650, 8000, 0.4)
+    for (const release of [0.03, 0.1, 0.3]) {
+      const random = randomSource(276430), audio = new Float32Array(clean.length)
+      let envelope = 0.01
+      for (let i = 0; i < audio.length; i++) {
+        const noise = Math.sqrt(-2 * Math.log(Math.max(random(), 1e-10))) * Math.cos(2 * Math.PI * random()) * 0.04 / Math.sqrt(2)
+        const sample = clean[i] + noise + 0.04 * Math.sin(2 * Math.PI * 650 * i / 8000)
+        const power = sample * sample
+        envelope += (1 - Math.exp(-1 / (8000 * (power > envelope ? 0.005 : release)))) * (power - envelope)
+        audio[i] = sample * 0.2 / Math.sqrt(envelope + 1e-6)
+      }
+      expect(characterErrors(text, decodeSamples(audio, 8000, { autoTune: false }).text).errors).toBeLessThanOrEqual(1)
+    }
+  })
+  test('does not interpret modest amplitude flutter on a continuous carrier as keying', () => {
+    for (const rate of [0.4, 2, 10]) {
+      const carrier = Float32Array.from({ length: 8000 * 20 }, (_, i) =>
+        0.3 * (1 + 0.3 * Math.sin(2 * Math.PI * rate * i / 8000)) * Math.sin(2 * Math.PI * 650 * i / 8000))
+      expect(decodeSamples(carrier, 8000, { autoTune: false }).text).toBe('')
+    }
+  })
